{
  "collection_interval_seconds": 5.0,
  "snapshot_interval_seconds": 5.0,
  "state_path": "state/world.json",
  "event_journal_path": "logs/events.jsonl",
  "presentation": {
    "enabled": true,
    "bind_host": "127.0.0.1",
    "port": 8765
  },
  "world_awareness": {
    "enabled": false,
    "location": {
      "label": "CONFIGURE_ME",
      "latitude": 0.0,
      "longitude": 0.0
    },
    "weather": {
      "enabled": false,
      "interval_seconds": 300.0,
      "timeout_seconds": 8.0
    },
    "alerts": {
      "enabled": false,
      "interval_seconds": 60.0,
      "timeout_seconds": 8.0,
      "user_agent": "Personal-CIC/0.3.6 (local personal system)"
    },
    "surface": {
      "enabled": false,
      "interval_seconds": 60.0,
      "timeout_seconds": 8.0,
      "user_agent": "Personal-CIC/0.3.6 (local personal system)",
      "station_ids": [
        "KXXX"
      ],
      "max_age_minutes": 90.0
    },
    "forecast": {
      "enabled": false,
      "interval_seconds": 300.0,
      "timeout_seconds": 8.0,
      "user_agent": "Personal-CIC/0.3.6 (local personal system)",
      "points_refresh_seconds": 21600.0
    },
    "radar": {
      "enabled": false,
      "interval_seconds": 120.0,
      "timeout_seconds": 8.0,
      "user_agent": "Personal-CIC/0.3.6 (local personal system)",
      "range_miles": 75.0,
      "image_width": 900,
      "image_height": 600,
      "max_age_minutes": 15.0,
      "cache_dir": "state/radar",
      "loop_frame_capacity": 15,
      "context_enabled": true,
      "context_interval_seconds": 21600.0,
      "context_timeout_seconds": 8.0,
      "context_max_age_days": 30.0
    },
    "traffic": {
      "enabled": false,
      "radius_miles": 75.0,
      "scope_counties": [
        "CONFIGURE_ME"
      ],
      "drivenc": {
        "enabled": false,
        "events_interval_seconds": 60.0,
        "cameras_interval_seconds": 1800.0,
        "signs_interval_seconds": 60.0,
        "timeout_seconds": 8.0,
        "api_key_env": "DRIVENC_API_KEY"
      },
      "wzdx": {
        "enabled": false,
        "interval_seconds": 900.0,
        "timeout_seconds": 30.0
      },
      "cmpd": {
        "enabled": false,
        "interval_seconds": 180.0,
        "timeout_seconds": 8.0
      },
      "charlotte_closures": {
        "enabled": false,
        "interval_seconds": 900.0,
        "timeout_seconds": 8.0
      },
      "external_waze_visual_enabled": true,
      "external_waze_zoom": 11,
      "tomtom": {
        "enabled": false,
        "incidents_interval_seconds": 14400.0,
        "flow_interval_seconds": 1200.0,
        "timeout_seconds": 8.0,
        "api_key_env": "TOMTOM_API_KEY",
        "flow_probes": [
          {
            "probe_id": "configure-me",
            "label": "configure before enabling traffic flow collection",
            "latitude": 0.0,
            "longitude": 0.0
          }
        ]
      }
    }
  },
  "operator_context": {
    "site_anchor": {
      "enabled": false
